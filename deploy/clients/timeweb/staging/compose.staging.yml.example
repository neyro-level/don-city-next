services:
  app-staging:
    image: "${IMAGE:?set an immutable image digest or immutable tag}"
    restart: unless-stopped
    env_file:
      - "${STAGING_ENV_FILE:?set a separate approved staging env file path}"
    environment:
      NODE_ENV: production
      JOBS_AUTORUN: "false"
    ports:
      - "127.0.0.1:3100:3000"
    read_only: true
    tmpfs:
      - /tmp

# Staging is an isolated rehearsal runtime. It must not use production data,
# production secrets or become the Payload jobs owner.
