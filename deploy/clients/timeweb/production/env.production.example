AMS_PROFILE=REALTY_BASE
TZ=Europe/Moscow
NODE_ENV=production
NEXT_PUBLIC_SERVER_URL=https://doncity-home.ru
INTERNAL_REVALIDATE_BASE_URL=http://127.0.0.1:3000
DATABASE_URI=
DATABASE_POOL_MAX=10
PAYLOAD_DB_PUSH=false
PAYLOAD_SECRET=
REVALIDATE_SECRET=
INTERNAL_HEALTH_SECRET=
JOBS_AUTORUN=true
S3_BUCKET=
S3_ENDPOINT=https://s3.twcstorage.ru
S3_REGION=ru-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=production/media
LEAD_CHANNELS=
LEAD_OUTBOUND_HOSTS=
OUTBOUND_ALLOWED_HOSTS=
EXTERNAL_IMAGE_HOSTS=
ARCHIVE_RETENTION_DAYS=100
ALERT_WEBHOOK_URL=
BACKUP_STATUS_PATH=/run/doncity/backup-status.json

# Materialize outside Git from Secret Master /production. An empty
# LEAD_CHANNELS value keeps real lead delivery/feed integrations disabled.
